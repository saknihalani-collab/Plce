# ─────────────────────────────────────────────────────────────
# PL·CE environment
#
# Leave every value blank to run in DEMO MODE: an in-memory
# database seeded with realistic studios, applications, bookings
# and customers, plus a stubbed sign-in (any email works, and the
# seed includes an owner, a customer and a PL·CE admin).
#
# Fill these in to connect real infrastructure — no code changes.
# ─────────────────────────────────────────────────────────────

# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by the WhatsApp webhook, which acts on behalf of a
# studio owner with no browser session to borrow authority from.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (metadata, absolute links, share URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── WhatsApp Business Cloud API ──────────────────────────────
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Echoed back during Meta's webhook handshake.
WHATSAPP_VERIFY_TOKEN=
# Meta signs every webhook body with this; unsigned bodies are rejected.
WHATSAPP_APP_SECRET=

# ── AI (natural-language intent extraction for WhatsApp) ─────
# Provider-agnostic. With no key set, a deterministic rule-based
# parser handles the common phrasings and asks a clarifying question
# whenever it is not certain — it never guesses a booking.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Maps ─────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Payments ─────────────────────────────────────────────────
# Abstraction only in this build; no live charges are made.
PAYMENTS_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Escape hatch for an intentionally credential-free preview deployment.
# A production build refuses to boot in demo mode without this, so a
# mistyped Supabase variable fails loudly instead of quietly serving an
# in-memory marketplace.
# ALLOW_DEMO_MODE=true
